{
  "name": "santorini",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/ai && tsc --noEmit -p apps/web && tsc --noEmit -p apps/trainer",
    "bench": "npm run bench -w @santorini/engine",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
